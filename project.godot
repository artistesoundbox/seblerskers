config_version=5

[application]

config/name="SEBLERSKERS"
run/main_scene="res://Levels/Main/L_Main.tscn"
config/features=PackedStringArray("4.7")
boot_splash/bg_color=Color(0, 0, 0, 1)
boot_splash/image="res://imports/sleblerskersload_cover_small.png"
